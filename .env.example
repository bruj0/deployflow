# Secrets this deployment needs, and the values for them.
# Copy to .env and fill in:  appctl secrets init
#
# .env is gitignored. Do not commit it, and do not paste its contents into
# a log, a ticket or a chat. `appctl secrets list` prints names only.

omniroute_jwt_secret=  # appctl secrets set omniroute_jwt_secret --generate
omniroute_api_key_secret=  # appctl secrets set omniroute_api_key_secret --generate
omniroute_storage_encryption_key=  # set me
omniroute_initial_password=  # set me
omniroute_ws_bridge_secret=  # appctl secrets set omniroute_ws_bridge_secret --generate
