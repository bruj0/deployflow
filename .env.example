# Secrets this deployment needs, and the values for them.
# Copy to .env and fill in:  appctl secrets init
#
# .env is gitignored. Do not commit it, and do not paste its contents into
# a log, a ticket or a chat. `appctl secrets list` prints names only.

omniroute_jwt_secret=  # appctl secrets set omniroute_jwt_secret --generate
omniroute_api_key_secret=  # appctl secrets set omniroute_api_key_secret --generate
omniroute_storage_encryption_key=  # set me
omniroute_initial_password=  # set me
omniroute_ws_bridge_secret=  # appctl secrets set omniroute_ws_bridge_secret --generate

# The OmniRoute guest installed from a published release. Its own set, because
# two guests run the same application and one flat .env cannot hold two
# storage encryption keys.
omniroute_release_jwt_secret=  # appctl secrets set omniroute_release_jwt_secret --generate
omniroute_release_api_key_secret=  # appctl secrets set omniroute_release_api_key_secret --generate
omniroute_release_storage_encryption_key=  # set me
omniroute_release_initial_password=  # set me
omniroute_release_ws_bridge_secret=  # appctl secrets set omniroute_release_ws_bridge_secret --generate
