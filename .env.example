# Secrets this deployment needs.
#
# Copy to .env and fill in. The .env file is gitignored, mode 0600, and never
# committed. `appctl secrets list` prints names and state, never values.
#
# Set a value with:  appctl secrets set NAME 'value'
# Generate one with:  appctl secrets set NAME --generate
#
# Every name listed here is required by an application in app.yaml. Add your
# own as you add applications.

# The sample application needs no secret. An application that exposes a
# listener on a wildcard address must have one: an application that refuses to
# start without a credential is refusing for good reason.
example_app_api_key=  # set me
