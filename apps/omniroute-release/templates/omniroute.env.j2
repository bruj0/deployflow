# OmniRoute non-secret settings. Read by bin/omniroute.mjs at start-up and
# handed to the server process.
#
# Role-owned: the next play rewrites this file byte-for-byte. OmniRoute also
# appends to it — `omniroute config lang set` persists OMNIROUTE_LANG here — so
# a setting changed through the CLI is reverted by the next install. That is the
# same trade apps/tencentdb-memory accepts for its rendered core.json; if it
# bites, move the setting into the secrets file rather than stopping the render.
#
# No credential appears here, and none can: the file is readable and a
# process environment key always wins over an .env key
# (bin/omniroute.mjs writes an .env value into process.env only when it is
# undefined), so this file holds settings and the EnvironmentFile holds secrets.
#
# OMNIROUTE_SERVER_HOST rather than HOSTNAME: HOSTNAME is a standard POSIX shell
# variable, and bin/cli/utils/serverHost.mjs deliberately ignores it on Linux and
# falls back to 0.0.0.0.
PORT={{ app_port }}
OMNIROUTE_SERVER_HOST={{ app_bind_host }}

# The realtime dashboard WebSocket binds loopback on its own, so it is set
# explicitly to match the published bind. Left at loopback, a dashboard reached
# over the LAN loses its live view and nothing reports it.
LIVE_WS_HOST={{ omr_live_ws_host }}
LIVE_WS_PORT={{ omr_live_ws_port }}

# The key gate on /v1/*. Off with a wildcard bind is the combination OmniRoute's
# own startup warning calls out: an inference plane any device on the network can
# spend, billed to the operator's providers.
REQUIRE_API_KEY={{ omr_require_api_key | bool | ternary('true', 'false') }}

# The local context-window check counts assistant reasoning the upstream
# provider does not count, so it refuses requests the provider would accept.
# Upstream enforces its own limit.
DISABLE_CONTEXT_WINDOW_CHECKS={{ omr_disable_context_window_checks | bool | ternary('true', 'false') }}

# Plain HTTP on a trusted LAN, so the cookie is not flagged secure — a secure
# cookie over http:// is never sent back and the dashboard cannot log in at all.
# Turn this on only with TLS terminated in front.
AUTH_COOKIE_SECURE=false

NODE_ENV=production
APP_LOG_LEVEL={{ omr_log_level }}

# A V8 heap ceiling; native buffers sit outside it.
OMNIROUTE_MEMORY_MB={{ omr_memory_mb }}
