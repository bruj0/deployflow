# OmniRoute credentials. Written by the omniroute-release role, root:omniroute
# 0640. systemd reads this as PID 1 before it drops to User={{ app_user }}, and
# the service account reads it through the operator wrapper in
# /usr/local/bin — read-only, and never writable by the account itself.
#
# Never committed, never in argv, never in ps, never in a rendered file.
#
# A process environment key wins over an .env key — bin/omniroute.mjs writes an
# .env value into process.env only when it is undefined — which is the whole
# reason these live here and not in {{ omr_env_file }}.
#
# A newline would end a line in the format systemd parses, so a value carrying
# one would be silently truncated into a different credential rather than
# rejected. The role asserts none of these contains one before writing the file.

# Signs dashboard session cookies. Auto-generated and persisted when absent,
# which would silently rotate on a wiped state directory and sign every operator
# out.
JWT_SECRET={{ omniroute_jwt_secret }}

# Encrypts stored provider API keys at rest. A rotated value leaves every stored
# credential undecryptable — this value and storage.sqlite are one backup set.
API_KEY_SECRET={{ omniroute_api_key_secret }}

# Database encryption. Set explicitly because OmniRoute otherwise generates one
# on first run and appends it to <DATA_DIR>/.env, which the role rewrites: the
# next play would drop the key and leave a database nothing can decrypt.
STORAGE_ENCRYPTION_KEY={{ omniroute_storage_encryption_key }}

# Applied once by the role's bootstrap task through `omniroute setup
# --non-interactive`, which reads it from the environment — never from argv.
# Consumed only while no administrator password has been saved yet.
INITIAL_PASSWORD={{ omniroute_initial_password }}

# Required in production and persisted nowhere, so it is ephemeral per boot:
# unset, every WebSocket bridge request is rejected.
OMNIROUTE_WS_BRIDGE_SECRET={{ omniroute_ws_bridge_secret }}
