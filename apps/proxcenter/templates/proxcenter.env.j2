# ProxCenter Community Edition — the stack's environment file.
#
# Written by the proxcenter role, mode 0600, owner root. It holds the four
# credentials the stack generates for itself and the settings that decide what
# the stack publishes.
#
# THE GENERATED VALUES ARE GENERATED ONCE AND NEVER REGENERATED. The role reads
# this file before writing it and keeps every value it finds. A regenerated
# POSTGRES_PASSWORD makes the database refuse its own new password; a
# regenerated APP_SECRET makes ProxCenter unable to decrypt the Proxmox token it
# stored, silently, with the symptom "the connection I saved has stopped
# working" rather than "the install failed".
#
# The Proxmox API token is NOT here. It is entered in the UI when the first
# connection is created, and ProxCenter encrypts it into its own database with
# APP_SECRET. The role writes it to a separate 0600 file for the operator to
# paste, so it never becomes part of the stack's environment.

APP_SECRET={{ proxcenter_app_secret }}
NEXTAUTH_SECRET={{ proxcenter_nextauth_secret }}
POSTGRES_PASSWORD={{ proxcenter_postgres_password }}

# Guards the first-run setup endpoint, which is reachable without
# authentication for as long as no account exists. Empty keeps the historical
# behaviour, which is fine on loopback and wrong on a LAN.
PROXCENTER_SETUP_TOKEN={{ proxcenter_setup_token }}

# The name the UI is reached on. A DHCP lease can move; a hostname does not.
NEXTAUTH_URL={{ proxcenter_public_url }}
APP_URL={{ proxcenter_public_url }}

# What the stack publishes. HTTP_BIND is the host port the container's 3000 is
# mapped to; HTTPS_BIND is set explicitly rather than left empty, because the
# upstream file maps "${HTTPS_BIND:-}:8443" and an empty value makes Docker pick
# a random free host port on every recreate.
HTTP_BIND={{ app_port }}
HTTPS_BIND=8443
TLS_PORT=8443
TLS_ENABLED=false

# The image tag the stack reports. The digest in the override file is what
# actually decides which image runs; this is the label the UI shows.
VERSION={{ proxcenter_frontend_version }}

# Postgres identity. The compose file defaults these, but writing them makes the
# database's own name visible in one place rather than two.
POSTGRES_USER=proxcenter
POSTGRES_DB=proxcenter

# No PDF renderer. The Community stack does not ship the WeasyPrint sidecar, and
# the client degrades to "PDF renderer not configured" rather than failing a
# report request. Set this to a sidecar's address to enable PDF export.
PROXCENTER_REPORTING_URL=
