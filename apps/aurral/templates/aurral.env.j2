# Aurral — the container's environment file.
#
# Written by the aurral role, mode 0600, owner root. It is read by Compose's own
# env_file handling rather than through a process environment, so no value
# reaches argv and `docker inspect` shows the file path rather than the key.

# The admin API key. Aurral refuses to start when this is set and shorter than
# 32 characters.
#
# It is generated once on the guest and kept. Aurral stores its own API key in
# the settings table when this is absent, so regenerating this value does not
# fail the install — it silently invalidates every script that authenticates
# with the old one. The role reads this file before writing it and keeps the
# value it finds.
AURRAL_API_KEY={{ aurral_api_key }}

# The data directory. /config is the canonical container path, so this states
# it rather than relying on the default, and the mount and the setting cannot
# drift apart.
AURRAL_DATA_DIR=/config

# The owner of the music and the state. The entrypoint runs as root, creates
# this user and drops to it, so these have to name an account that owns the
# bind-mounted directories.
PUID={{ aurral_uid }}
PGID={{ aurral_gid }}

# The Library folder, inside the media mount. Aurral's default is
# /data/downloads/aurral; it is stated here so the path a second service has to
# share is visible in one place instead of two.
LIBRARY_FOLDER=/data/downloads/aurral

# The timezone the app renders times in. UTC is the guest's own default and
# the honest one for a server.
TZ={{ aurral_timezone }}

# The public address of the instance. Used for OAuth callbacks and for the
# links Aurral puts in a share.
AURRAL_PUBLIC_URL={{ aurral_public_url }}

# Read the client address from X-Forwarded-For when the request comes from a
# private address. The Cloudflare tunnel connector reaches Aurral from the
# guest's own network, so this is what makes the client address the real one
# rather than the connector's.
TRUST_PROXY=1
