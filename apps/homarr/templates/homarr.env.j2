# Homarr — the container's environment file.
#
# Written by the homarr role, mode 0600, owner root. It is read by Compose's own
# env_file handling rather than through a process environment, so no value
# reaches argv and `docker inspect` shows the file path rather than the key.
#
# THE ENCRYPTION KEY IS GENERATED ONCE AND NEVER REGENERATED. The role reads
# this file before writing it and keeps the value it finds. Homarr encrypts
# every stored integration credential with SECRET_ENCRYPTION_KEY, so a
# regenerated key does not fail the install — it makes every saved integration
# secret undecryptable, silently, with the symptom "the integration I saved has
# stopped working" rather than "the install failed".
#
# The key must be 64 hex characters. Homarr validates it at startup and exits
# with "SECRET_ENCRYPTION_KEY is required, please generate a 64 character
# secret in hex format" otherwise, so the role generates hex rather than the
# base64 that appctl's own generator produces.

SECRET_ENCRYPTION_KEY={{ homarr_secret_encryption_key }}

# SQLite inside /appdata, which is the bind mount. Written explicitly rather
# than left to the image's default so the database's location is visible in one
# place instead of two.
DB_DRIVER=better-sqlite3
DB_DIALECT=sqlite
DB_URL=/appdata/db/db.sqlite

# The internal userbase. Homarr's first user is created by the onboarding flow
# on first visit; LDAP and OIDC are available but need a directory or an
# identity provider, neither of which this role assumes.
AUTH_PROVIDERS=credentials

# The image starts its own Redis and talks to it over loopback. Declared so a
# later change to an external Redis is a one-line edit here rather than a
# discovery.
REDIS_IS_EXTERNAL=false

# The timezone the board renders times in. UTC is the guest's own default and
# the honest one for a server; set it in the guest's group_vars to localise.
TZ={{ homarr_timezone }}
