[Unit]
Description=Homarr dashboard (Docker Compose)
Documentation=https://homarr.dev/
# The engine has to be up before the container can be started, and the
# container needs the network to reach the integrations it displays.
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes

# The project directory, because `docker compose` resolves its files relative to
# the working directory when no -f is given — and this unit always gives one.
WorkingDirectory={{ homarr_project_dir }}

# `--pull never` is what makes the digest pin real: without it, `up` fetches the
# tag the compose file names and the digest is never consulted.
ExecStart=/usr/bin/docker compose -f {{ homarr_compose_file }} up -d --pull never --remove-orphans
ExecStop=/usr/bin/docker compose -f {{ homarr_compose_file }} down

# A container that fails to come up should be retried, not left half-started.
# The entrypoint runs the database migrations before the server binds, so a
# first boot is tens of seconds.
TimeoutStartSec={{ homarr_health_timeout }}
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
